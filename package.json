{
  "name": "tcc-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:migrate": "tsx src/migrate.ts",
    "supabase:check": "tsx --env-file=.env.supabase src/check-database.ts",
    "supabase:migrate": "tsx --env-file=.env.supabase src/migrate.ts",
    "supabase:usuario": "tsx --env-file=.env.supabase src/create-user.ts",
    "usuario:criar": "tsx src/create-user.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "format": "prettier --write src tests scripts package.json tsconfig.json compose.yaml README.md",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json compose.yaml README.md"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
